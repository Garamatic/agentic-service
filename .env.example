# APIs
TICKET_API_URL=http://localhost:5000
ODOO_BRIDGE_URL=http://localhost:5001

# API Keys (optional — leave empty to disable auth)
API_KEY=
TICKET_API_KEY=
ODOO_BRIDGE_API_KEY=

# API server
API_HOST=0.0.0.0
API_PORT=3001

# CORS — comma-separated origins or "*"
CORS_ORIGINS=*

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_VHOST=/

# Logging
LOG_LEVEL=INFO

# Agent / LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Approval threshold for invoices requiring human approval
APPROVAL_THRESHOLD=500.0

# MCP server transport (sse or stdio)
MCP_TRANSPORT=sse

# Agent persistence (leave empty for in-memory)
AGENT_DB_PATH=

# Mail defaults
MAIL_FROM_EMAIL=support@garamatic.com
MAIL_FROM_NAME=Garamatic Support
MAIL_BILLING_FROM_EMAIL=billing@garamatic.com
MAIL_BILLING_FROM_NAME=Garamatic Billing
MAIL_SYSTEM_FROM_EMAIL=system@garamatic.com
MAIL_SYSTEM_FROM_NAME=Garamatic System
